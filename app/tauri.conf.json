{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fastrixi",
  "version": "1.2.0",
  "identifier": "com.s1steam.fastrixi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "Fastrixi",
      "width": 1000,
      "height": 600,
      "decorations": false,
      "resizable": false,
      "center": true,
      "fullscreen": false,
      "devtools": false,
      "theme": "Dark",
      "transparent": true,
      "shadow": false
    }],
    "security": {
      "csp": null,
      "capabilities": [{
        "identifier": "draggable-window",
        "windows": ["*"],
        "permissions": [
          "core:window:default",
          "core:window:allow-start-dragging",
          "core:window:allow-minimize",
          "core:event:allow-listen",
          "core:event:default",
          "core:path:allow-is-absolute",
          "core:path:default",
          "dialog:allow-open",
          "dialog:default",
          "fs:allow-write-file",
          "fs:default"
        ]
      }]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}